{
  "manifest_version": 2,
  "name": "Notify→Bark Forwarder",
  "version": "1.0",
  "description": "捕获网页 Notification 并通过 Bark 推送到手机（支持去重、速率限制与重试）",
  "permissions": [
    "storage",
    "notifications",
    "<all_urls>",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_inject.js"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "Notify→Bark",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.png"
  }
}
